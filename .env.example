# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The address your cards will point to. Locally use http://localhost:3000.
# On Vercel set it to https://triio.vercel.app (or whatever subdomain you get).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Automations (all optional, so the site works without them). See README → Automations.
# None of these start with NEXT_PUBLIC_, so they never reach the browser.
# ---------------------------------------------------------------------

# Email (https://resend.com → API Keys). Until you verify your own domain in Resend,
# EMAIL_FROM must stay onboarding@resend.dev and Resend only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM=Triio <onboarding@resend.dev>
# Where customers' replies go (your Gmail is fine).
EMAIL_REPLY_TO=
# Where alerts and the daily digest go (can also be set on the Automations page).
ADMIN_ALERT_EMAIL=

# Lead finder: Google Places API (New). Leave empty to use OpenStreetMap (free, no review counts).
GOOGLE_PLACES_API_KEY=

# The 8:00 AM schedule. CRON_SECRET: any long random text. Vercel sends it automatically.
CRON_SECRET=
# Supabase → Project Settings → API Keys → service_role / secret key.
# Only the scheduled job uses it (no one is logged in at 8 AM). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
